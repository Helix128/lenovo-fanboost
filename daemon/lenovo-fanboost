#!/usr/bin/python3 -I
"""lenovo-fanboost: check and control the fan boost service.

  lenovo-fanboost [status]               show service state, profile and fan metrics
  lenovo-fanboost watch                  live telemetry, once per second
  lenovo-fanboost profile PROFILE        switch curve profile (Quiet|Balanced|Aggressive)
  lenovo-fanboost on | off               enable or disable the service (root)

The continuous fan curve policy runs in lenovo-fanboostd (lenovo-fanboost.service).
"""
import argparse
import glob
import os
import re
import subprocess
import sys
import time
import tomllib

SERVICE = "lenovo-fanboost.service"
CONFIG = "/etc/lenovo-fanboost.toml"
HWMON_ROOT = "/sys/class/hwmon"

PROFILES = ("Quiet", "Balanced", "Aggressive")
LEVEL_ALIAS = {
    "low": "Quiet",
    "medium": "Balanced",
    "high": "Aggressive"
}


def find_hwmon(name, root):
    for p in sorted(glob.glob(os.path.join(root, "hwmon*", "name"))):
        try:
            with open(p) as f:
                if f.read().strip() == name:
                    return os.path.dirname(p)
        except OSError:
            pass
    return None


def rd(d, n):
    if not d:
        return None
    try:
        with open(os.path.join(d, n)) as f:
            return f.read().strip()
    except OSError:
        return None


def systemctl(*args):
    r = subprocess.run(["systemctl", *args], capture_output=True, text=True)
    return r.returncode, r.stdout.strip()


def read_config(path):
    try:
        with open(path, "rb") as f:
            raw = tomllib.load(f)
            fb_sec = raw.get("fanboost", {})
            profile = fb_sec.get("profile")
            if not profile and "level" in fb_sec:
                profile = LEVEL_ALIAS.get(fb_sec["level"], "Balanced")
            return {
                "profile": profile or "Balanced",
                "interval": fb_sec.get("interval", 0.5),
                "profiles": raw.get("profiles", {})
            }
    except (OSError, tomllib.TOMLDecodeError):
        return {"profile": "Balanced", "interval": 0.5, "profiles": {}}


def status_line(a):
    fan = find_hwmon("lenovo_fanboost", a.hwmon_root)
    kt = find_hwmon("k10temp", a.hwmon_root)
    t = rd(kt, "temp1_input")
    target = rd(fan, "fan1_target")
    max_rpm = rd(fan, "fan1_max") or "4000"
    mode = "boost" if target not in (None, "0") else "auto"
    pct_str = ""
    if target and target.isdigit() and int(target) > 0 and max_rpm.isdigit() and int(max_rpm) > 0:
        pct = (int(target) / int(max_rpm)) * 100
        pct_str = f" ({pct:.0f}%)"
    elif target == "0":
        pct_str = " (0%)"
    return (f"cpu {int(t) / 1000:5.1f}°C  fan {mode:5}  target {target or '-':>4} rpm{pct_str}  "
            f"ec speed {rd(fan, 'fan1_raw') or '-'}") if t else "sensors unavailable"


def cmd_status(a):
    _, active = systemctl("is-active", SERVICE)
    _, enabled = systemctl("is-enabled", SERVICE)
    cfg = read_config(a.config)
    state = "Active" if active == "active" else "Inactive (EC Mode)"
    print(f"state    {state} (service: {active}, {enabled})")
    print(f"profile  {cfg['profile']}")
    if not find_hwmon("lenovo_fanboost", a.hwmon_root):
        print("module   not loaded (sudo modprobe lenovo_fanboost)")
    print(status_line(a))


def cmd_watch(a):
    try:
        while True:
            print(f"{time.strftime('%T')}  {status_line(a)}", flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        pass


def need_root(cmd):
    if os.geteuid() != 0:
        sys.exit(f"this needs root: sudo lenovo-fanboost {cmd}")


def set_profile_in_config(config_path, profile_name):
    try:
        with open(config_path) as f:
            text = f.read()
    except FileNotFoundError:
        text = '[fanboost]\nprofile = "Balanced"\n'

    new, n = re.subn(r'(?m)^(\s*profile\s*=\s*)"[^"]+"', rf'\g<1>"{profile_name}"', text)
    if not n:
        new, n = re.subn(r'(?m)^(\s*level\s*=\s*)"[^"]+"', rf'profile = "{profile_name}"', text)
    if not n:
        new = text.rstrip("\n") + f'\nprofile = "{profile_name}"\n'

    tomllib.loads(new)
    with open(config_path, "w") as f:
        f.write(new)


def cmd_profile(a):
    profile = a.profile
    if profile.lower() in LEVEL_ALIAS:
        profile = LEVEL_ALIAS[profile.lower()]
    need_root(f"profile {profile}")

    set_profile_in_config(a.config, profile)
    rc, active = systemctl("is-active", SERVICE)
    if active == "active":
        systemctl("restart", SERVICE)
    print(f"profile set to {profile}" + (" (service restarted)" if active == "active" else ""))


def cmd_onoff(a):
    need_root(a.cmd)
    verb = "enable" if a.cmd == "on" else "disable"
    rc, _ = systemctl(verb, "--now", SERVICE)
    if rc:
        sys.exit(f"systemctl {verb} failed")
    state = "Active" if a.cmd == "on" else "Inactive (EC Mode)"
    print(f"state is now {state}")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="lenovo-fanboost", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config", default=CONFIG, help=argparse.SUPPRESS)
    ap.add_argument("--hwmon-root", default=HWMON_ROOT, help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("status")
    sub.add_parser("watch")

    prof = sub.add_parser("profile")
    prof.add_argument("profile")

    # Legacy alias
    lv = sub.add_parser("level")
    lv.add_argument("profile")

    sub.add_parser("on")
    sub.add_parser("off")
    a = ap.parse_args(argv)
    handler = {
        None: cmd_status,
        "status": cmd_status,
        "watch": cmd_watch,
        "profile": cmd_profile,
        "level": cmd_profile,
        "on": cmd_onoff,
        "off": cmd_onoff
    }.get(a.cmd, cmd_status)
    handler(a)


if __name__ == "__main__":
    main()
