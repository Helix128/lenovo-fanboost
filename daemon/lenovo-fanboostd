#!/usr/bin/python3 -I
"""lenovo-fanboostd: policy daemon (run by systemd).

Continuously evaluates CPU temperature against an active fan curve profile,
interpolating target percentages, converting to laptop-specific hardware RPMs,
and setting fan1_target on the lenovo_fanboost hwmon device.
"""
import argparse
import glob
import os
import signal
import sys
import time
import tomllib

HWMON_ROOT = "/sys/class/hwmon"
CONFIG = "/etc/lenovo-fanboost.toml"

DEFAULT_PROFILES = {
    "Quiet": [
        [40, 0], [60, 0], [70, 45], [80, 65], [90, 90], [95, 100]
    ],
    "Balanced": [
        [40, 0], [50, 0], [60, 45], [70, 65], [80, 85], [90, 100]
    ],
    "Aggressive": [
        [40, 0], [45, 40], [55, 60], [65, 80], [75, 100], [95, 100]
    ]
}

LEGACY_MAP = {
    "low": "Quiet",
    "medium": "Balanced",
    "high": "Aggressive"
}


def find_hwmon(name, root=HWMON_ROOT):
    for p in sorted(glob.glob(os.path.join(root, "hwmon*", "name"))):
        try:
            with open(p) as f:
                if f.read().strip() == name:
                    return os.path.dirname(p)
        except OSError:
            pass
    return None


def clamp(val, min_val, max_val):
    return max(min_val, min(max_val, val))


def interpolate_percent(points, temp):
    """Interpolate fan percentage (0.0 - 100.0) from [temp, percent] curve points."""
    if not points:
        return 0.0
    if temp <= points[0][0]:
        return float(clamp(points[0][1], 0.0, 100.0))
    if temp >= points[-1][0]:
        return float(clamp(points[-1][1], 0.0, 100.0))

    for i in range(len(points) - 1):
        t0, p0 = points[i]
        t1, p1 = points[i + 1]
        if t0 <= temp <= t1:
            if t1 == t0:
                pct = p0
            else:
                pct = p0 + ((temp - t0) / (t1 - t0)) * (p1 - p0)
            return float(clamp(pct, 0.0, 100.0))
    return 0.0


def percent_to_rpm(percent, max_rpm=4000):
    """Convert a target fan percentage (0-100) to RPM (0 only for 0%)."""
    if percent <= 0.0 or max_rpm <= 0:
        return 0
    rpm = round((percent / 100.0) * max_rpm)
    return int(clamp(rpm, 1, max_rpm))


def interpolate_curve(points, temp, max_rpm=4000):
    """Linearly interpolate target RPM from a list of [temp, percent] pairs."""
    pct = interpolate_percent(points, temp)
    return percent_to_rpm(pct, max_rpm)


def load_config(path):
    raw = {}
    try:
        with open(path, "rb") as f:
            raw = tomllib.load(f)
    except FileNotFoundError:
        pass

    fb_sec = raw.get("fanboost", {})
    profiles = dict(DEFAULT_PROFILES)
    for name, pdata in raw.get("profiles", {}).items():
        if isinstance(pdata, dict) and "points" in pdata:
            profiles[name] = pdata["points"]

    profile_name = fb_sec.get("profile")
    if not profile_name and "level" in fb_sec:
        profile_name = LEGACY_MAP.get(fb_sec["level"], "Balanced")
    if not profile_name or profile_name not in profiles:
        profile_name = "Balanced"

    interval = float(fb_sec.get("interval", 0.5))
    if not 0.05 <= interval <= 10.0:
        interval = 0.5

    points = profiles[profile_name]
    clean_points = []
    for pt in points:
        if isinstance(pt, (list, tuple)) and len(pt) >= 2:
            t = float(pt[0])
            p = float(clamp(float(pt[1]), 0.0, 100.0))
            clean_points.append([t, p])
    clean_points.sort(key=lambda p: p[0])
    if not clean_points:
        clean_points = DEFAULT_PROFILES["Balanced"]

    return {
        "profile": profile_name,
        "interval": interval,
        "points": clean_points,
        "profiles": profiles
    }


class Fan:
    def __init__(self, hwmon):
        self.target = os.path.join(hwmon, "fan1_target")
        self.max_path = os.path.join(hwmon, "fan1_max")
        self.max_rpm = self._read_max()

    def _read_max(self):
        try:
            with open(self.max_path) as f:
                val = int(f.read().strip())
                if val > 0:
                    return val
        except (OSError, ValueError):
            pass
        return 4000

    def set(self, rpm):
        with open(self.target, "w") as f:
            f.write(f"{int(rpm)}\n")

    def get(self):
        with open(self.target) as f:
            return int(f.read())


class CurveController:
    """Evaluates continuous fan curve and emits target RPM changes."""

    def __init__(self, points, max_rpm=4000):
        self.points = sorted(points, key=lambda p: p[0])
        self.max_rpm = max_rpm
        self.current_target = 0

    def step(self, temp):
        target = interpolate_curve(self.points, temp, self.max_rpm)
        if target != self.current_target:
            self.current_target = target
            return target
        return None

    def fault(self):
        """Sensor unavailable: return control to EC."""
        if self.current_target != 0:
            self.current_target = 0
            return 0
        return None


def log(msg):
    print(msg, flush=True)


def run(cfg, fan, read_temp, clock=time.monotonic, sleep=time.sleep,
        stop=lambda: False):
    max_rpm = getattr(fan, "max_rpm", 4000)
    ctl = CurveController(cfg["points"], max_rpm=max_rpm)
    fan.set(0)
    log(f"start profile={cfg['profile']} max_rpm={max_rpm} "
        f"interval={cfg['interval']}s points={cfg['points']}")
    faulted = False
    try:
        while not stop():
            try:
                t = read_temp()
                if faulted:
                    log("sensor recovered")
                faulted = False
            except (OSError, ValueError):
                if not faulted:
                    log("sensor error, releasing to auto")
                faulted = True
                if ctl.fault() is not None:
                    fan.set(0)
                sleep(cfg["interval"])
                continue

            target = ctl.step(t)
            if target is not None:
                fan.set(target)
                if target > 0:
                    pct = (target / max_rpm) * 100 if max_rpm > 0 else 0
                    log(f"boost tctl={t:.1f} target={target} ({pct:.0f}%)")
                else:
                    log(f"auto tctl={t:.1f} (EC control)")
            sleep(cfg["interval"])
    finally:
        try:
            fan.set(0)
            log("exit: fan returned to automatic")
        except OSError as e:
            log(f"exit: failed to write auto: {e}")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--config", default=CONFIG)
    ap.add_argument("--hwmon-root", default=HWMON_ROOT)
    a = ap.parse_args(argv)

    try:
        cfg = load_config(a.config)
    except (ValueError, tomllib.TOMLDecodeError, OSError) as e:
        sys.exit(f"config error: {e}")

    fh = find_hwmon("lenovo_fanboost", a.hwmon_root)
    kt = find_hwmon("k10temp", a.hwmon_root)
    if not fh or not kt:
        sys.exit("hwmon lenovo_fanboost or k10temp not found")
    if not os.access(os.path.join(fh, "fan1_target"), os.W_OK):
        sys.exit("lenovo-fanboostd needs root permissions to set fan speeds.\n"
                 "It runs as lenovo-fanboost.service; use `lenovo-fanboost` CLI.")

    tpath = os.path.join(kt, "temp1_input")

    def read_temp():
        with open(tpath) as f:
            return int(f.read()) / 1000

    def term(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGINT, term)
    signal.signal(signal.SIGHUP, term)
    run(cfg, Fan(fh), read_temp)


if __name__ == "__main__":
    main()
